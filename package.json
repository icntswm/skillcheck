{
  "name": "skillcheck",
  "version": "0.1.0",
  "description": "Regression tests for Claude Code skills: check that every request still loads the right skill",
  "type": "module",
  "bin": {
    "skillcheck": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "keywords": [
    "claude-code",
    "skills",
    "agents",
    "routing",
    "eval",
    "regression-testing"
  ],
  "license": "MIT",
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/icntswm/skillcheck.git"
  },
  "homepage": "https://github.com/icntswm/skillcheck#readme"
}
